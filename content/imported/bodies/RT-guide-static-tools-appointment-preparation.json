{"id": "RT-guide-static-tools-appointment-preparation", "body": {"t": "main", "a": {"id": "main-content", "class": "wrap"}, "c": [{"t": "p", "c": [{"t": "a", "a": {"href": "/"}, "c": ["MJB ADHD home"]}, " · ", {"t": "a", "a": {"href": "/guide/"}, "c": ["Guidebook"]}]}, {"t": "p", "c": [{"t": "a", "a": {"href": "/guide/static/"}, "c": ["MJB ADHD"]}, " · Static reading view · ", {"t": "a", "a": {"href": "/guide/#/n/appointment-preparation"}, "c": ["Interactive version"]}]}, {"t": "h1", "c": ["Prepare for an appointment"]}, {"t": "p", "c": [{"t": "small", "c": ["Status: drafted · Content checked 2026-10-06"]}]}, {"t": "p", "a": {"class": "lede"}, "c": ["A one-page sheet that turns weeks of experience into the decision you need, three examples, and focused questions."]}, " ", {"t": "section", "a": {"class": "layer", "data-guide-layer": "1"}, "c": [{"t": "h2", "c": ["Build your sheet"]}, {"t": "p", "c": ["Clinicians have little time. A sheet that leads with the decision you need, then three concrete examples, gets further than a long history. Nothing you type is stored or sent."]}, " ", {"t": "h3", "c": ["Appointment worksheet"]}, {"t": "p", "c": ["Record your main concern, symptom timeline, current medicines and substances, benefit and adverse effects, previous tests, questions, and the decision or follow-up plan you need. Copy these prompts into a document to complete them."]}]}, " ", {"t": "section", "a": {"class": "layer", "data-guide-layer": "3"}, "c": [{"t": "h2", "c": ["Useful next action"]}, {"t": "ul", "c": [{"t": "li", "a": {"class": "check"}, "c": [{"t": "label", "c": [{"t": "input", "a": {"type": "checkbox"}}, " ", {"t": "span", "c": ["Lead with the one decision you need"]}]}]}, {"t": "li", "a": {"class": "check"}, "c": [{"t": "label", "c": [{"t": "input", "a": {"type": "checkbox"}}, " ", {"t": "span", "c": ["Bring exact medicine names, manufacturers and strengths"]}]}]}, {"t": "li", "a": {"class": "check"}, "c": [{"t": "label", "c": [{"t": "input", "a": {"type": "checkbox"}}, " ", {"t": "span", "c": ["Bring three dated examples, not general descriptions"]}]}]}, {"t": "li", "a": {"class": "check"}, "c": [{"t": "label", "c": [{"t": "input", "a": {"type": "checkbox"}}, " ", {"t": "span", "c": ["Ask for the plan in writing before you leave"]}]}]}]}]}, " ", {"t": "section", "a": {"class": "layer", "data-guide-layer": "6"}, "c": [{"t": "h2", "c": ["Useful resources"]}, {"t": "p", "c": ["Find purpose-labelled external reading, videos, support groups and tools in ", {"t": "a", "a": {"class": "xl", "data-node": "adhd-resources", "href": "/guide/static/about/adhd-resources/"}, "c": ["ADHD resources: find what you need"]}, "."]}]}, " ", {"t": "section", "c": [{"t": "h2", "c": ["Uncertainty"]}, {"t": "p", "c": ["A good sheet improves communication; it cannot guarantee a particular decision."]}]}, " ", {"t": "section", "c": [{"t": "h2", "c": ["Sources cited"]}, {"t": "ol"}]}, {"t": "nav", "c": [{"t": "p", "c": [{"t": "a", "a": {"href": "/guide/static/care/no-prescriber/"}, "c": ["Next action: When nobody owns the next prescribing decision"]}, " · ", {"t": "a", "a": {"href": "/guide/static/treatment/restarting-after-gap/"}, "c": ["Related: Restarting after a gap"]}, " · ", {"t": "a", "a": {"href": "/guide/static/understand/memory-time-awareness/"}, "c": ["Deeper: Memory, time and awareness"]}]}]}]}}